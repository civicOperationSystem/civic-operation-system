FROM node:24-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG NEXT_PUBLIC_CIVIC_PARENT_ORIGINS=http://localhost:3100
ENV NEXT_PUBLIC_CIVIC_PARENT_ORIGINS=$NEXT_PUBLIC_CIVIC_PARENT_ORIGINS
ENV CIVIC_API_URL=http://backend:3030
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
USER node
EXPOSE 3101
CMD ["npm", "start", "--", "-p", "3101"]
